# Rently - Environment Configuration

# --------------------------------------------------------------------------
# Firebase Authentication Configuration
# Create a web app in Firebase Console (https://console.firebase.google.com/)
# Enable Google Sign-In & Phone Number Authentication under Authentication > Sign-in method.
# --------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=rently-hyperlocal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rently-hyperlocal
VITE_FIREBASE_STORAGE_BUCKET=rently-hyperlocal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# --------------------------------------------------------------------------
# Backend API Base URL
# --------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
