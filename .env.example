# Rently - Environment Configuration

# --------------------------------------------------------------------------
# Firebase Client Configuration (Web App)
# Create a web project in Firebase Console (https://console.firebase.google.com/)
# Enable:
#   1. Authentication (Google Sign-In & Phone Number)
#   2. Cloud Firestore (Start in production or test mode)
#   3. Cloud Storage (for vehicle inspection & damage photos)
# --------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:abcdef123456

# --------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# Obtain test/live API keys from Razorpay Dashboard (https://dashboard.razorpay.com/)
# --------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# --------------------------------------------------------------------------
# Backend Firebase Admin SDK (Optional: For server-side privileged Firestore)
# Download Service Account JSON from Project Settings > Service Accounts
# Option A: Path to service account file
# Option B: Paste raw JSON string in FIREBASE_SERVICE_ACCOUNT_KEY
# --------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY=

# --------------------------------------------------------------------------
# Backend API Base URL & Server Port
# --------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
PORT=3001
HOST=0.0.0.0
